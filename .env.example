# Copy this file to .env and fill in the values

# Port of the server
PORT=3031

# Secret for signing JWT tokens. REQUIRED — the server refuses to start without a
# real value of at least 32 characters. Generate one with:
#   node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
JWT_SECRET=

# Expiration time for authorization tokens
JWT_EXPIRES_IN=24h

# Upload limits (bytes). Per-file default 1 GiB; whole uploads/ folder 20 GiB.
UPLOADS_MAX_FILE_BYTES=
UPLOADS_MAX_TOTAL_BYTES=

# Whether to trust the X-Forwarded-For header for the client IP. Used for the
# activity-log IP and for keying the rate limiters — behind a reverse proxy this
# MUST be set, or every client shares the proxy's address and trips the login
# limiter together. Leave empty for a direct connection; otherwise set it to the
# proxy hop count (e.g. 1), a subnet, or "loopback".
TRUST_PROXY=
